---
import '../styles/global.css';
import { SITE_URL, BASE_URL, PROFILE, SOCIALS } from '@config/site';
import { type Lang, getAlternateLang, getAlternatePath } from '@i18n/utils';
import Nav from '@components/Nav.astro';
import Footer from '@components/Footer.astro';
import Particles from '@components/Particles.astro';
import Aurora from '@components/Aurora.astro';
import SocialLinks from '@components/SocialLinks.astro';

interface Props {
  lang?: Lang;
  title?: string;
  description?: string;
}

const { lang = 'es', title, description } = Astro.props;

const defaultTitle = `${PROFILE.name} — Full Stack Developer`;
const defaultDesc =
  lang === 'es'
    ? 'Desarrollador en Sevilla. Trabajo en IA y ciberseguridad en Kentia Engineering y contribuyo a software para calibración de ECUs. React, Tauri, FastAPI y PostgreSQL.'
    : 'Software developer based in Seville, Spain. I work in AI and cybersecurity at Kentia Engineering and contribute to ECU calibration software. React, Tauri, FastAPI and PostgreSQL.';

const resolvedTitle = title ?? defaultTitle;
const resolvedDesc = description ?? defaultDesc;

const canonical = `${SITE_URL}${Astro.url.pathname}`;
// Purpose-built 1200x630 social cards, one per language.
const ogImage = `${SITE_URL}${BASE_URL}/images/${lang === 'en' ? 'og-en' : 'og'}.png`;
const ogImageAlt =
  lang === 'es'
    ? `${PROFILE.name} — Desarrollador Web Full Stack`
    : `${PROFILE.name} — Full Stack Web Developer`;
// schema.org/Person wants an actual photo of the person, not the social card.
const photoUrl = `${SITE_URL}${BASE_URL}/images/ismael-retrato.jpg`;
const ogLocale = lang === 'es' ? 'es_ES' : 'en_US';
const alternateLang = getAlternateLang(lang);
const alternatePath = getAlternatePath(lang);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: PROFILE.name,
  url: `${SITE_URL}${BASE_URL}/`,
  image: photoUrl,
  jobTitle: lang === 'es' ? 'IA y Ciberseguridad' : 'AI & Cybersecurity',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Sevilla',
    addressCountry: 'ES',
  },
  alumniOf: [
    {
      '@type': 'EducationalOrganization',
      name: 'Cesur Sevilla',
      description: 'Técnico Superior en Desarrollo de Aplicaciones Web (DAW)',
    },
  ],
  knowsAbout: [
    'Java', 'PHP', 'Python', 'JavaScript', 'TypeScript',
    'Laravel', 'Spring Boot', 'Django', 'React',
    'MySQL', 'PostgreSQL', 'REST API', 'Git',
  ],
  sameAs: [SOCIALS.github, SOCIALS.linkedin, SOCIALS.instagram],
};
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <!-- iOS turns "1–2 semanas", "9:00–19:00" and the like into blue phone/date links -->
    <meta name="format-detection" content="telephone=no, date=no, address=no" />
    <meta name="description" content={resolvedDesc} />
    <meta name="theme-color" content="#0a0f1c" />
    <meta name="color-scheme" content="light dark" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang={lang} href={canonical} />
    <link rel="alternate" hreflang={alternateLang} href={`${SITE_URL}${alternatePath}`} />
    <link rel="alternate" hreflang="x-default" href={`${SITE_URL}${BASE_URL}/`} />

    <!-- OG -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={resolvedTitle} />
    <meta property="og:description" content={resolvedDesc} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content={PROFILE.name} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={resolvedTitle} />
    <meta name="twitter:description" content={resolvedDesc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href={`${BASE_URL}/favicon.svg`} />

    <!--
      Fonts are self-hosted (see @fontsource-variable imports in global.css),
      so there is no third-party connection to preconnect to.
      This flag runs before first paint: reveal animations are only armed
      when JS is confirmed alive, so a JS failure can never leave the page blank.
    -->
    <script is:inline>
      document.documentElement.classList.add('js');
      // Theme before first paint: dark unless the visitor chose light
      (function () {
        var theme = 'dark';
        try {
          if (localStorage.getItem('portfolio-theme') === 'light') theme = 'light';
        } catch (e) {}
        document.documentElement.dataset.theme = theme;
        var m = document.querySelector('meta[name="theme-color"]');
        if (m) m.setAttribute('content', theme === 'dark' ? '#0a0f1c' : '#faf7f2');
      })();
    </script>

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <title>{resolvedTitle}</title>
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      {lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}
    </a>
    <Aurora />
    <Particles />
    <Nav lang={lang} />
    <SocialLinks variant="rail" lang={lang} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />

    <script>
      // One observer for every [data-reveal] on the page. Individual sections
      // opt in with `style="--delay: 120ms"` to stagger within a group.
      const reveal = (el: Element) => el.classList.add('is-visible');
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');

      let observerReported = false;
      const observer = new IntersectionObserver(
        (entries) => {
          observerReported = true;
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const el = entry.target as HTMLElement;
            observer.unobserve(el);
            const delay = parseInt(el.style.getPropertyValue('--delay'), 10) || 0;
            delay ? window.setTimeout(() => reveal(el), delay) : reveal(el);
          }
        },
        { threshold: 0.12, rootMargin: '0px 0px -8% 0px' }
      );

      targets.forEach((el) => observer.observe(el));

      // Section titles: wrap every word so CSS can lift it out of a mask.
      // The heading keeps its full text for assistive tech; the spans are decoration.
      document.querySelectorAll<HTMLElement>('.section-title:not(.contact-title)').forEach((title) => {
        if (title.children.length > 0) return;
        const text = (title.textContent ?? '').trim();
        if (!text) return;
        title.setAttribute('aria-label', text);
        title.classList.add('is-split');
        title.textContent = '';
        text.split(/\s+/).forEach((word, i, all) => {
          const outer = document.createElement('span');
          outer.className = 'w';
          outer.setAttribute('aria-hidden', 'true');
          const inner = document.createElement('span');
          inner.className = 'w-in';
          inner.style.setProperty('--wi', String(i));
          inner.textContent = word;
          outer.appendChild(inner);
          title.appendChild(outer);
          if (i < all.length - 1) title.appendChild(document.createTextNode(' '));
        });
      });

      // Soft light following the pointer on [data-spotlight] cards (mouse only)
      if (window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
        document.querySelectorAll<HTMLElement>('[data-spotlight]').forEach((card) => {
          card.addEventListener(
            'pointermove',
            (e) => {
              const r = card.getBoundingClientRect();
              card.style.setProperty('--mx', `${e.clientX - r.left}px`);
              card.style.setProperty('--my', `${e.clientY - r.top}px`);
            },
            { passive: true }
          );
        });
      }

      // Safety net: if the observer never reports back (broken or unsupported),
      // reveal everything after 3s instead of leaving the page blank. When it
      // works, sections must keep waiting for their scroll-in.
      window.setTimeout(() => {
        if (!observerReported) targets.forEach(reveal);
      }, 3000);
    </script>
  </body>
</html>
