---
// Custom cursor + spotlight driver. A single pointermove listener feeds both,
// so the whole thing is one rAF loop. Skipped entirely on touch devices.
---

<div id="cursor" aria-hidden="true">
  <span class="cursor-dot"></span>
  <span class="cursor-ring"></span>
</div>

<script>
  const root = document.getElementById('cursor');
  const fine = window.matchMedia('(pointer: fine)');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (root && fine.matches) {
    document.documentElement.classList.add('has-custom-cursor');

    const ring = root.querySelector<HTMLElement>('.cursor-ring')!;
    const dot = root.querySelector<HTMLElement>('.cursor-dot')!;

    // Selector for anything that should make the ring bloom
    const INTERACTIVE = 'a, button, [role="tab"], input, textarea, select, summary';

    let visible = false;

    function onMove(e: PointerEvent) {
      const tx = e.clientX;
      const ty = e.clientY;

      if (!visible) {
        visible = true;
        root!.classList.add('is-active');
      }

      // Dot and ring track the pointer exactly — no lag, so neither can
      // ever drift away from the real cursor position near viewport edges.
      dot.style.transform = `translate3d(${tx}px, ${ty}px, 0)`;
      ring.style.transform = `translate3d(${tx}px, ${ty}px, 0)`;

      // Spotlight: hand the hovered surface its local pointer position
      const surface = (e.target as Element)?.closest?.<HTMLElement>('[data-spotlight]');
      if (surface) {
        const r = surface.getBoundingClientRect();
        surface.style.setProperty('--mx', `${e.clientX - r.left}px`);
        surface.style.setProperty('--my', `${e.clientY - r.top}px`);
      }

      root!.classList.toggle('is-hot', !!(e.target as Element)?.closest?.(INTERACTIVE));
    }

    if (!reduced.matches) {
      window.addEventListener('pointermove', onMove, { passive: true });
      window.addEventListener('pointerdown', () => root.classList.add('is-down'));
      window.addEventListener('pointerup', () => root.classList.remove('is-down'));
      document.addEventListener('pointerleave', () => {
        visible = false;
        root.classList.remove('is-active');
      });
    }
  }
</script>

<style is:global>
  /* Hide the native cursor only once ours is confirmed running */
  .has-custom-cursor,
  .has-custom-cursor a,
  .has-custom-cursor button,
  .has-custom-cursor [role='tab'] {
    cursor: none;
  }

  #cursor {
    position: fixed;
    inset: 0;
    z-index: 9998;
    pointer-events: none;
    opacity: 0;
    transition: opacity 200ms ease;
  }

  #cursor.is-active {
    opacity: 1;
  }

  .cursor-dot,
  .cursor-ring {
    position: fixed;
    top: 0;
    left: 0;
    border-radius: 50%;
    will-change: transform;
  }

  .cursor-dot {
    width: 6px;
    height: 6px;
    margin: -3px 0 0 -3px;
    background: var(--color-accent);
  }

  .cursor-ring {
    width: 30px;
    height: 30px;
    margin: -15px 0 0 -15px;
    border: 1px solid #a3e63566;
    transition:
      width 220ms var(--ease-out-soft),
      height 220ms var(--ease-out-soft),
      margin 220ms var(--ease-out-soft),
      border-color 220ms ease,
      background 220ms ease;
  }

  /* Blooms over anything clickable */
  #cursor.is-hot .cursor-ring {
    width: 52px;
    height: 52px;
    margin: -26px 0 0 -26px;
    border-color: var(--color-accent);
    background: #a3e6351a;
  }

  #cursor.is-down .cursor-ring {
    width: 22px;
    height: 22px;
    margin: -11px 0 0 -11px;
  }

  @media (prefers-reduced-motion: reduce) {
    .has-custom-cursor,
    .has-custom-cursor a,
    .has-custom-cursor button {
      cursor: auto;
    }
    #cursor { display: none; }
  }
</style>
