---
import { stack } from '@data/stack';
import { type Lang } from '@i18n/ui';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;

const names = stack.flatMap((c) => c.techs).filter((t) => t.level === 'primary').map((t) => t.name);
---

<div class="marquee" role="group" aria-label={lang === 'es' ? 'Tecnologías principales' : 'Main technologies'}>
  <div class="marquee-track">
    {[0, 1].map((copy) => (
      <ul class="marquee-list" aria-hidden={copy === 1 ? 'true' : undefined}>
        {names.map((name) => <li>{name}</li>)}
      </ul>
    ))}
  </div>
</div>

<style>
  .marquee {
    position: relative;
    z-index: 1;
    overflow: hidden;
    border-block: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg-sunken) 70%, transparent);
    mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
    -webkit-mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
  }

  .marquee-track {
    display: flex;
    width: max-content;
  }

  .marquee-list {
    display: flex;
    flex: none;
    list-style: none;
  }

  .marquee-list li {
    display: flex;
    align-items: center;
    gap: 2.2rem;
    padding-block: 1.1rem;
    padding-right: 2.2rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2vw, 1.35rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--color-text-muted);
  }

  .marquee-list li::after {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    opacity: 0.7;
  }

  @media (prefers-reduced-motion: no-preference) {
    .marquee-track {
      animation: marquee-scroll 38s linear infinite;
    }

    @media (hover: hover) {
      .marquee:hover .marquee-track {
        animation-play-state: paused;
      }
    }
  }

  @keyframes marquee-scroll {
    to { transform: translateX(-50%); }
  }

  /* Without motion the strip just wraps into a static, readable row */
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      mask-image: none;
      -webkit-mask-image: none;
    }
    .marquee-track {
      width: auto;
    }
    .marquee-list {
      flex-wrap: wrap;
    }
    .marquee-list[aria-hidden='true'] {
      display: none;
    }
  }
</style>
