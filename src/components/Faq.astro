---
import { type Lang } from '@i18n/ui';
import { faq } from '@data/services';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;
const es = lang === 'es';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q[lang],
    acceptedAnswer: { '@type': 'Answer', text: f.a[lang] },
  })),
};
---

<section id="preguntas" class="fq">
  <div class="container fq-grid">
    <div data-reveal>
      <p class="section-eyebrow">
        <span class="section-index">05</span>
        <span class="section-label">{es ? 'Preguntas' : 'FAQ'}</span>
      </p>
      <h2 class="section-title">{es ? 'Antes de decidirte' : 'Before you decide'}</h2>
      <div class="fq-ask">
        <p><strong>{es ? '¿Tienes otra pregunta?' : 'Got another question?'}</strong></p>
        <p>{es ? 'Escríbeme y te respondo el mismo día.' : 'Write to me and I’ll reply the same day.'}</p>
        <a href="#contacto" class="btn btn-primary">{es ? 'Preguntar' : 'Ask'}</a>
      </div>
    </div>

    <div class="fq-list" data-reveal style="--delay: 100ms">
      {faq.map((f, i) => (
        <details name="faq" open={i === 0}>
          <summary>
            {f.q[lang]}
            <span class="fq-plus" aria-hidden="true" />
          </summary>
          <p>{f.a[lang]}</p>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</section>

<style>
  .fq-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .fq-ask {
    display: grid;
    gap: 0.4rem;
    justify-items: start;
    margin-top: 2rem;
    padding: 1.4rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-bg-elevated);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .fq-ask strong {
    color: var(--color-text);
  }

  .fq-ask .btn {
    margin-top: 0.6rem;
  }

  .fq-list {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-bg-elevated);
    padding: 0.4rem 1.4rem;
  }

  details + details {
    border-top: 1px solid var(--color-border);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.15rem 0;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .fq-plus {
    position: relative;
    flex: none;
    width: 30px;
    height: 30px;
    border: 1px solid var(--color-border-strong);
    border-radius: 50%;
    transition: transform var(--transition-base), background var(--transition-base);
  }

  .fq-plus::before,
  .fq-plus::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 11px;
    height: 1.5px;
    margin: -0.75px 0 0 -5.5px;
    background: currentColor;
  }

  .fq-plus::after {
    transform: rotate(90deg);
  }

  details[open] .fq-plus {
    transform: rotate(45deg);
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #0a0a0b;
  }

  details p {
    padding-bottom: 1.2rem;
    max-width: 62ch;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  @media (max-width: 860px) {
    .fq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
