---
// No hamburger, no overlay: on small screens the header keeps only what a
// visitor needs (logo, "about", language, quote). The page itself is one
// scroll, and every section is reachable from the hero and the footer.
import { type Lang } from '@i18n/ui';
import { getAlternateLang, getAlternatePath, getHomePath, getAboutPath } from '@i18n/utils';
import ScrollProgress from '@components/ScrollProgress.astro';

interface Props {
  lang?: Lang;
  page?: 'home' | 'about';
}

const { lang = 'es', page = 'home' } = Astro.props;
const es = lang === 'es';
const alternateLang = getAlternateLang(lang);
const alternatePath = getAlternatePath(lang, page);
const home = getHomePath(lang);
const about = getAboutPath(lang);

const navLinks = [
  { href: `${home}#servicios`, label: es ? 'Servicios' : 'Services' },
  { href: `${home}#presupuesto`, label: es ? 'Presupuesto' : 'Quote' },
  { href: `${home}#proceso`, label: es ? 'Cómo trabajo' : 'How I work' },
  { href: `${home}#trabajos`, label: es ? 'Trabajos' : 'Work' },
  { href: `${home}#preguntas`, label: es ? 'Preguntas' : 'FAQ' },
];
---

<header class="nav-header" role="banner">
  <nav class="nav-inner container" aria-label={es ? 'Navegación principal' : 'Main navigation'}>
    <a href={home} class="nav-logo" aria-label={es ? 'Inicio' : 'Home'}>
      <span class="nav-logo-text">IPR</span>
      <span class="nav-logo-dot" aria-hidden="true"></span>
    </a>

    <ul class="nav-links" role="list">
      {navLinks.map((link) => (
        <li>
          <a href={link.href} class="nav-link">{link.label}</a>
        </li>
      ))}
    </ul>

    <div class="nav-actions">
      <a
        href={about}
        class:list={['nav-link', 'nav-about', { active: page === 'about' }]}
        aria-current={page === 'about' ? 'page' : undefined}
      >
        {es ? 'Sobre mí' : 'About'}
      </a>

      <a
        href={alternatePath}
        class="lang-toggle"
        hreflang={alternateLang}
        aria-label={alternateLang === 'en' ? 'Switch to English' : 'Cambiar a español'}
      >
        <span class="lang-current">{lang.toUpperCase()}</span>
        <span class="lang-sep" aria-hidden="true">/</span>
        <span class="lang-alt">{alternateLang.toUpperCase()}</span>
      </a>

      <a href={`${home}#contacto`} class="btn btn-primary nav-cta">
        <span class="cta-long">{es ? 'Pedir presupuesto' : 'Get a quote'}</span>
        <span class="cta-short">{es ? 'Presupuesto' : 'Quote'}</span>
      </a>
    </div>
  </nav>
  <ScrollProgress />
</header>

<script>
  const header = document.querySelector<HTMLElement>('.nav-header');
  const links = document.querySelectorAll<HTMLAnchorElement>('.nav-links .nav-link');

  // Only touch the class when the state actually flips, not on every scroll event
  let scrolled = false;
  const onScroll = () => {
    const next = window.scrollY > 20;
    if (next !== scrolled) {
      scrolled = next;
      header?.classList.toggle('scrolled', next);
    }
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  // Scroll-spy (wide screens only show these links anyway)
  const sections = document.querySelectorAll<HTMLElement>('section[id]');
  if (links.length && sections.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          const id = `#${entry.target.id}`;
          links.forEach((link) => link.classList.toggle('active', (link.getAttribute('href') ?? '').endsWith(id)));
        }
      },
      { rootMargin: '-40% 0px -55% 0px' }
    );
    sections.forEach((s) => observer.observe(s));
  }

  document.querySelector<HTMLAnchorElement>('.lang-toggle')?.addEventListener('click', (e) => {
    const href = (e.currentTarget as HTMLAnchorElement).getAttribute('href') ?? '';
    try {
      localStorage.setItem('portfolio-lang', href.includes('/en/') ? 'en' : 'es');
    } catch {
      /* private mode: not important */
    }
  });
</script>

<style>
  .nav-header {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    transition: background-color 250ms ease, box-shadow 250ms ease;
  }

  .nav-header.scrolled {
    background-color: color-mix(in srgb, var(--color-bg) 88%, transparent);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--color-border);
  }

  /* Touch screens: a solid header. backdrop-filter on a fixed bar is what
     makes iOS Safari stutter while scrolling. */
  @media (hover: none) {
    .nav-header,
    .nav-header.scrolled {
      background-color: var(--color-bg);
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      box-shadow: 0 1px 0 var(--color-border);
      transition: none;
    }
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 64px;
  }

  .nav-logo {
    display: flex;
    align-items: center;
    gap: 4px;
    flex: none;
    text-decoration: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }

  .nav-logo-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    margin-bottom: 8px;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    list-style: none;
  }

  .nav-link {
    position: relative;
    text-decoration: none;
    color: var(--color-text-muted);
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    white-space: nowrap;
    transition: color 200ms ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-accent);
    transition: width 200ms ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--color-text);
  }

  .nav-link.active::after {
    width: 100%;
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
  }

  .lang-toggle {
    display: flex;
    align-items: center;
    gap: 0.2rem;
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    padding: 0.3rem 0.5rem;
    transition: border-color 150ms ease;
  }

  .lang-current {
    color: var(--color-accent);
  }

  .lang-sep {
    color: var(--color-border-strong);
  }

  .lang-alt {
    color: var(--color-text-muted);
  }

  .lang-toggle:hover {
    border-color: var(--color-accent);
  }

  .nav-cta {
    padding: 0.45rem 0.95rem;
    font-size: 0.8rem;
    white-space: nowrap;
  }

  .nav-cta:hover {
    transform: none;
  }

  .cta-short {
    display: none;
  }

  @media (max-width: 1080px) {
    .nav-links {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .nav-actions {
      gap: 0.6rem;
    }
    .cta-long {
      display: none;
    }
    .cta-short {
      display: inline;
    }
    .nav-cta {
      padding: 0.42rem 0.8rem;
    }
  }

  @media (max-width: 360px) {
    .nav-about {
      display: none;
    }
  }
</style>
