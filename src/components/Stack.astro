---
import { stack } from '@data/stack';
import { type Lang } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);
---

<section id="stack" class="stack-section">
  <div class="container">
    <header class="section-head" data-reveal>
      <div>
        <p class="section-eyebrow">
          <span class="section-index" data-parallax style="--parallax: 0.6">01</span>
          <span class="section-label">{t('stack.label')}</span>
        </p>
        <h2 class="section-title">{t('stack.title')}</h2>
      </div>
      <p class="section-subtitle">{t('stack.subtitle')}</p>
    </header>

    <div class="stack-rows">
      {
        stack.map((category, i) => (
          <article class="stack-row" data-reveal style={`--delay: ${i * 70}ms`}>
            <div class="row-head">
              <span class="row-index" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div>
                <h3 class="row-title">{t(`stack.${category.id}.title` as any)}</h3>
                <p class="row-desc">{t(`stack.${category.id}.desc` as any)}</p>
              </div>
            </div>

            <ul
              class="tech-list"
              aria-label={`${t('stack.label')}: ${t(`stack.${category.id}.title` as any)}`}
            >
              {category.techs.map((tech) => (
                <li class={tech.level === 'primary' ? 'tech is-primary' : 'tech'}>
                  {tech.name}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .stack-rows {
    border-top: 1px solid var(--color-border);
  }

  .stack-row {
    display: grid;
    grid-template-columns: minmax(0, 20rem) minmax(0, 1fr);
    column-gap: clamp(1.5rem, 5vw, 4rem);
    row-gap: 1.1rem;
    align-items: start;
    padding-block: clamp(1.6rem, 3vw, 2.4rem);
    border-bottom: 1px solid var(--color-border);
    transition: background var(--transition-base);
  }

  .stack-row:hover {
    background: linear-gradient(
      to right,
      color-mix(in srgb, var(--color-accent) 4%, transparent),
      transparent 60%
    );
  }

  /* ---- Left: category ---- */
  .row-head {
    display: flex;
    gap: 0.9rem;
    align-items: baseline;
  }

  .row-index {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-accent);
    letter-spacing: 0.08em;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums;
  }

  .row-title {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 1.8vw, 1.25rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-text);
  }

  .row-desc {
    font-size: 0.82rem;
    color: var(--color-text-faint);
    line-height: 1.55;
    margin-top: 0.25rem;
    max-width: 34ch;
  }

  /* ---- Right: technologies ----
     Typographic marks, not boxed chips: primary reads as headline weight,
     secondary recedes. Keeps the section quiet at a glance and scannable up close.
  */
  .tech-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 0.55rem;
    list-style: none;
    padding-top: 0.15rem;
  }

  .tech {
    font-size: 0.85rem;
    line-height: 1.4;
    padding: 0.28rem 0.7rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    color: var(--color-text-faint);
    background: var(--color-bg-elevated);
    transition:
      color var(--transition-fast),
      border-color var(--transition-fast),
      transform var(--transition-fast),
      background var(--transition-fast);
  }

  .tech.is-primary {
    color: var(--color-text);
    border-color: var(--color-border-strong);
    font-weight: 500;
  }

  .stack-row:hover .tech.is-primary {
    border-color: var(--color-border-accent);
    color: var(--color-accent);
  }

  .tech:hover {
    transform: translateY(-2px);
    border-color: var(--color-border-accent);
    background: color-mix(in srgb, var(--color-accent) 8%, var(--color-bg-elevated));
  }

  @media (max-width: 860px) {
    .stack-row {
      grid-template-columns: 1fr;
    }
    .row-desc {
      max-width: 100%;
    }
  }
</style>
