---
import { type Lang } from '@i18n/ui';
import { steps } from '@data/services';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;
const es = lang === 'es';
---

<section id="proceso" class="pr">
  <div class="container">
    <header class="section-head" data-reveal>
      <div>
        <p class="section-eyebrow">
          <span class="section-index">03</span>
          <span class="section-label">{es ? 'Cómo trabajo' : 'How I work'}</span>
        </p>
        <h2 class="section-title">{es ? 'De la primera llamada a tenerlo funcionando.' : 'From the first call to up and running.'}</h2>
      </div>
      <div class="pr-split">
        <p><strong>50 %</strong><span>{es ? 'al aceptar la propuesta' : 'when you accept'}</span></p>
        <p><strong>50 %</strong><span>{es ? 'al entregar' : 'on delivery'}</span></p>
      </div>
    </header>

    <ol class="pr-steps" role="list">
      {steps.map((s, i) => (
        <li class:list={['pr-step', { last: i === steps.length - 1 }]} data-reveal style={`--delay: ${i * 90}ms`}>
          <div class="pr-head">
            <span class="pr-num">{String(i + 1).padStart(2, '0')}</span>
            <span class="pr-tag">{s.tag[lang]}</span>
          </div>
          <h3>{s.title[lang]}</h3>
          <p>{s.text[lang]}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .pr-split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .pr-split p {
    display: grid;
    padding: 0.9rem 1.1rem;
  }

  .pr-split p + p {
    border-left: 1px solid var(--color-border);
  }

  .pr-split strong {
    font-family: var(--font-display);
    font-size: 1.6rem;
    letter-spacing: -0.03em;
  }

  .pr-split span {
    font-size: 0.78rem;
    color: var(--color-text-faint);
  }

  .pr-steps {
    position: relative;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1rem;
    list-style: none;
  }

  /* The rail that joins the four steps */
  .pr-steps::before {
    content: '';
    position: absolute;
    top: -1.4rem;
    left: 12%;
    right: 12%;
    height: 2px;
    background: linear-gradient(to right, var(--color-accent-deep), var(--color-accent));
  }

  .pr-step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.4rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-xl);
    background: var(--color-bg-elevated);
  }

  .pr-step::before {
    content: '';
    position: absolute;
    top: calc(-1.4rem - 5px);
    left: 50%;
    width: 12px;
    height: 12px;
    margin-left: -6px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px var(--color-bg);
  }

  .pr-step.last {
    background: var(--color-accent-solid);
    border-color: var(--color-accent-solid);
    color: var(--color-on-accent);
  }

  .pr-step.last p,
  .pr-step.last .pr-tag {
    color: #ffffffd9;
    border-color: #ffffff59;
  }

  .pr-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.2rem;
  }

  .pr-num {
    font-family: var(--font-display);
    font-size: 2.4rem;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .pr-tag {
    padding: 0.2rem 0.6rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    font-size: 0.72rem;
    color: var(--color-text-muted);
  }

  .pr-step h3 {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .pr-step p {
    font-size: 0.86rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .pr-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .pr-steps::before,
    .pr-step::before {
      display: none;
    }
  }

  @media (max-width: 520px) {
    .pr-steps {
      grid-template-columns: 1fr;
    }
  }
</style>
