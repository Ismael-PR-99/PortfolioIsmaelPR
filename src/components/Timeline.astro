---
import { timeline } from '@data/timeline';
import { type Lang } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const filters = [
  { id: 'all', label: t('timeline.filter.all') },
  { id: 'experience', label: t('timeline.filter.experience') },
  { id: 'education', label: t('timeline.filter.education') },
] as const;

const badgeClass: Record<string, string> = {
  Formación: 'is-education',
  Certificación: 'is-cert',
  Prácticas: 'is-experience',
  Empleo: 'is-experience',
};

function badgeLabel(badge: string, l: Lang): string {
  if (l !== 'en') return badge;
  const map: Record<string, string> = {
    Formación: t('timeline.badge.education'),
    Certificación: t('timeline.badge.cert'),
    Prácticas: t('timeline.badge.experience'),
    Empleo: t('timeline.badge.job'),
  };
  return map[badge] ?? badge;
}
---

<section id="timeline" class="timeline-section">
  <div class="container">
    <header class="section-head" data-reveal>
      <div>
        <p class="section-eyebrow">
          <span class="section-index">02</span>
          <span class="section-label">{t('timeline.label')}</span>
        </p>
        <h2 class="section-title">{t('timeline.title')}</h2>
      </div>
      <p class="section-subtitle">{t('timeline.subtitle')}</p>
    </header>

    <div
      class="filter-tabs"
      role="tablist"
      aria-label={lang === 'es' ? 'Filtrar trayectoria' : 'Filter journey'}
      data-reveal
    >
      {
        filters.map((filter, i) => (
          <button
            type="button"
            role="tab"
            class={`filter-btn ${i === 0 ? 'active' : ''}`}
            data-filter={filter.id}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls="timeline-list"
            tabindex={i === 0 ? 0 : -1}
          >
            {filter.label}
          </button>
        ))
      }
    </div>

    <ol id="timeline-list" class="timeline-list" role="tabpanel">
      {
        timeline.map((item, i) => (
          <li
            class="entry"
            data-spotlight
            data-type={item.type}
            data-reveal
            style={`--delay: ${i * 70}ms`}
          >
            <!-- Rail: dates -->
            <div class="entry-rail">
              <time class="entry-date">
                {lang === 'en' && item.dateStartEn ? item.dateStartEn : item.dateStart}
                <span class="date-sep" aria-hidden="true">→</span>
                {item.dateEnd
                  ? lang === 'en' && item.dateEndEn
                    ? item.dateEndEn
                    : item.dateEnd
                  : t('timeline.present')}
              </time>
              <span class={`entry-badge ${badgeClass[item.badge] ?? ''}`}>
                {badgeLabel(item.badge, lang)}
              </span>
            </div>

            <!-- Body -->
            <div class="entry-body">
              <div class="entry-heading">
                <h3 class="entry-title">{item.title}</h3>
                {item.current && (
                  <span class="entry-current">
                    <span class="current-dot" aria-hidden="true" />
                    {t('timeline.current')}
                  </span>
                )}
              </div>

              <p class="entry-org">
                <span class="entry-institution">{item.institution}</span>
                <span class="entry-dot" aria-hidden="true">·</span>
                <span class="entry-location">{item.location}</span>
              </p>

              <p class="entry-desc">{item.description}</p>

              {item.tags && item.tags.length > 0 && (
                <ul
                  class="entry-tags"
                  aria-label={lang === 'es' ? 'Tecnologías' : 'Technologies'}
                >
                  {item.tags.map((tag) => (
                    <li>{tag}</li>
                  ))}
                </ul>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<script>
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.filter-btn');
  const entries = document.querySelectorAll<HTMLElement>('.entry');

  function applyFilter(filter: string) {
    entries.forEach((entry) => {
      const show = filter === 'all' || entry.dataset.type === filter;
      entry.hidden = !show;
    });
  }

  function activateTab(btn: HTMLButtonElement) {
    filterBtns.forEach((b) => {
      b.classList.toggle('active', b === btn);
      b.setAttribute('aria-selected', String(b === btn));
      b.setAttribute('tabindex', b === btn ? '0' : '-1');
    });
    btn.focus();
    applyFilter(btn.dataset.filter ?? 'all');
  }

  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => activateTab(btn));

    btn.addEventListener('keydown', (e) => {
      const btns = Array.from(filterBtns);
      const idx = btns.indexOf(btn);
      const go = (next: number) => {
        e.preventDefault();
        activateTab(btns[(next + btns.length) % btns.length]);
      };

      if (e.key === 'ArrowRight' || e.key === 'ArrowDown') go(idx + 1);
      else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') go(idx - 1);
      else if (e.key === 'Home') go(0);
      else if (e.key === 'End') go(btns.length - 1);
    });
  });
</script>

<style>
  /* ---------------------------------------------------------------
     Filters — quiet text toggles, not pill buttons
  --------------------------------------------------------------- */
  .filter-tabs {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 2.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .filter-btn {
    position: relative;
    background: none;
    border: none;
    padding: 0 0 0.75rem;
    font: inherit;
    font-size: 0.85rem;
    color: var(--color-text-faint);
    cursor: pointer;
    transition: color var(--transition-fast);
  }

  .filter-btn::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    height: 1px;
    background: var(--color-accent);
    scale: 0 1;
    transition: scale var(--transition-base);
  }

  .filter-btn:hover {
    color: var(--color-text);
  }

  .filter-btn.active {
    color: var(--color-text);
    font-weight: 600;
  }

  .filter-btn.active::after {
    scale: 1 1;
  }

  /* ---------------------------------------------------------------
     Entries — date rail + body, separated by hairlines
  --------------------------------------------------------------- */
  .timeline-list {
    list-style: none;
  }

  .entry {
    display: grid;
    grid-template-columns: minmax(0, 13rem) minmax(0, 1fr);
    column-gap: clamp(1.5rem, 5vw, 3.5rem);
    row-gap: 0.9rem;
    padding-block: clamp(1.6rem, 3vw, 2.3rem);
    border-bottom: 1px solid var(--color-border);
  }

  .entry[hidden] {
    display: none;
  }

  /* ---- Rail ---- */
  .entry-rail {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }

  .entry-date {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
    text-transform: uppercase;
  }

  .date-sep {
    color: var(--color-border-strong);
  }

  .entry-badge {
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    padding: 0.2rem 0.5rem;
    border-radius: var(--radius-sm);
    border: 1px solid var(--color-border);
    color: var(--color-text-faint);
  }

  .entry-badge.is-experience {
    color: var(--color-accent);
    border-color: var(--color-border-accent);
    background: #a3e6350d;
  }

  .entry-badge.is-cert {
    color: #7dd3fc;
    border-color: #7dd3fc33;
    background: #7dd3fc0d;
  }

  .entry-badge.is-education {
    color: #c4b5fd;
    border-color: #c4b5fd33;
    background: #c4b5fd0d;
  }

  /* ---- Body ---- */
  .entry-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.9rem;
    margin-bottom: 0.35rem;
  }

  .entry-title {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.8vw, 1.2rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: var(--color-text);
    text-wrap: balance;
  }

  .entry-current {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    white-space: nowrap;
  }

  .current-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: pulse-dot 2.4s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.3; }
  }

  .entry-org {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-bottom: 0.7rem;
  }

  .entry-institution {
    font-weight: 500;
    color: var(--color-text);
  }

  .entry-dot,
  .entry-location {
    color: var(--color-text-faint);
  }

  .entry-desc {
    font-size: 0.88rem;
    line-height: 1.7;
    color: var(--color-text-muted);
    max-width: 68ch;
  }

  .entry-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    list-style: none;
    margin-top: 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .entry-tags li + li::before {
    content: '/';
    margin-right: 0.75rem;
    color: var(--color-border-strong);
  }

  @media (max-width: 860px) {
    .entry {
      grid-template-columns: 1fr;
    }
    .entry-rail {
      flex-direction: row;
      align-items: center;
      gap: 0.75rem;
    }
  }
</style>
