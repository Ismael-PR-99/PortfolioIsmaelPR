---
// One source for every place the social links appear: the hero row, the fixed
// side rail on wide screens, the mobile menu and the footer.
import { CONTACT, SOCIALS } from '@config/site';

interface Props {
  variant?: 'hero' | 'rail' | 'menu' | 'footer';
  lang?: 'es' | 'en';
}
const { variant = 'hero', lang = 'es' } = Astro.props;

const icons = {
  github:
    '<path fill="currentColor" stroke="none" d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/>',
  linkedin:
    '<path fill="currentColor" stroke="none" d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>',
  instagram:
    '<rect x="2" y="2" width="20" height="20" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.6" cy="6.4" r="0.6" fill="currentColor"/>',
  email: '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 6-10 7L2 6"/>',
};

const links = [
  { id: 'github', label: 'GitHub', handle: '@Ismael-PR-99', href: SOCIALS.github },
  { id: 'linkedin', label: 'LinkedIn', handle: 'Ismael Piña Ramos', href: SOCIALS.linkedin },
  { id: 'instagram', label: 'Instagram', handle: '@ismael_pr99', href: SOCIALS.instagram },
  ...(CONTACT.email
    ? [{ id: 'email', label: lang === 'es' ? 'Email' : 'Email', handle: CONTACT.email, href: `mailto:${CONTACT.email}` }]
    : []),
] as const;
---

<ul class:list={['soc', `soc-${variant}`]} role="list" aria-label={lang === 'es' ? 'Mis redes' : 'My profiles'}>
  {links.map((l) => (
    <li>
      <a
        href={l.href}
        target={l.id === 'email' ? undefined : '_blank'}
        rel={l.id === 'email' ? undefined : 'noopener noreferrer me'}
        class="soc-link"
        aria-label={`${l.label} — ${l.handle}`}
        title={variant === 'rail' ? `${l.label} · ${l.handle}` : undefined}
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={icons[l.id]} />
        {variant !== 'rail' && <span class="soc-label">{l.id === 'email' ? l.handle : l.label}</span>}
      </a>
    </li>
  ))}
</ul>

<style>
  .soc {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .soc-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-text-muted);
    transition: color var(--transition-fast), border-color var(--transition-fast), background var(--transition-fast), translate var(--transition-fast);
  }

  @media (hover: hover) {
    .soc-link:hover {
      color: var(--color-accent);
    }
  }

  /* Hero: pill buttons with labels */
  .soc-hero .soc-link,
  .soc-menu .soc-link,
  .soc-footer .soc-link {
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: var(--color-bg-elevated);
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--color-text);
  }

  @media (hover: hover) {
    .soc-hero .soc-link:hover,
    .soc-menu .soc-link:hover,
    .soc-footer .soc-link:hover {
      border-color: var(--color-accent);
      background: color-mix(in srgb, var(--color-accent) 8%, transparent);
      color: var(--color-accent);
      translate: 0 -2px;
    }
  }

  .soc-menu {
    justify-content: center;
  }

  /* Rail: fixed vertical strip on the left of wide screens */
  .soc-rail {
    position: fixed;
    left: clamp(1rem, 2vw, 2rem);
    bottom: 0;
    z-index: 50;
    flex-direction: column;
    align-items: center;
    gap: 1.1rem;
  }

  .soc-rail::after {
    content: '';
    width: 1px;
    height: 90px;
    background: var(--color-border-strong);
  }

  .soc-rail .soc-link {
    padding: 0.2rem;
  }

  @media (hover: hover) {
    .soc-rail .soc-link:hover {
      translate: 0 -3px;
    }
  }

  @media (max-width: 1279px) {
    .soc-rail {
      display: none;
    }
  }

  /* Stacked (mobile/tablet) layouts: centre the pills under their caption */
  @media (max-width: 900px) {
    .soc-hero,
    .soc-footer {
      justify-content: center;
    }
  }
</style>
