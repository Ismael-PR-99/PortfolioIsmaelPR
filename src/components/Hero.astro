---
import { BASE_URL, PROFILE, SOCIALS } from '@config/site';
import { type Lang } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';
import projects from '@data/projects.json';
import { stack } from '@data/stack';
import { timeline } from '@data/timeline';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

const photo = `${BASE_URL}/images/IsmaelFoto`;

const chips = [t('hero.chip.location'), t('hero.chip.level'), t('hero.chip.type')];
const [roleBefore, roleAfter] = t('hero.role').split('Full Stack');

// Real counts, derived from the same data the other sections render —
// never hand-typed numbers that drift out of sync.
const stats = [
  { value: projects.length, label: t('hero.stat.projects') },
  { value: stack.reduce((n, c) => n + c.techs.length, 0), label: t('hero.stat.techs') },
  { value: timeline.length, label: t('hero.stat.milestones') },
];

// Marks used in the portrait frame — the stack he actually ships with.
const frameTech = ['Java', 'Laravel', 'React', 'Python', 'PostgreSQL'];

// Split the name at build time so each letter can carry its own animation
// delay. Done here rather than in a client script so the markup ships whole
// and the entrance stays pure CSS.
const nameLetters = [...PROFILE.name].map((char, i) => ({
  char,
  isSpace: char === ' ',
  i,
}));
---

<section id="hero" class="hero-section">
  <div class="container hero-grid">
    <!-- Left: text -->
    <div class="hero-content">
      <span class="availability-badge" style="--i: 0">
        <span class="badge-dot" aria-hidden="true"></span>
        {t('hero.badge')}
      </span>

      <h1 class="hero-name" style="--i: 1">
        <span class="hero-greeting">{t('hero.greeting')}</span>
        <span class="name-letters" aria-label={PROFILE.name}>
          {
            nameLetters.map(({ char, isSpace, i }) =>
              isSpace ? (
                <span class="letter-space" aria-hidden="true">
                  {' '}
                </span>
              ) : (
                <span class="letter" style={`--l: ${i}`} aria-hidden="true">
                  {char}
                </span>
              )
            )
          }
        </span>
      </h1>

      <p class="hero-role" style="--i: 2">
        {roleBefore}<span class="role-accent">Full Stack</span>{roleAfter}
      </p>

      <p class="hero-bio" style="--i: 3">{t('hero.bio')}</p>

      <ul class="hero-chips" style="--i: 4" aria-label="Perfil profesional">
        {chips.map((chip) => <li class="chip">{chip}</li>)}
      </ul>

      <div class="hero-ctas" style="--i: 5">
        <a href="#projects" class="btn btn-primary">
          {t('hero.cta.projects')}
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="m6 9 6 6 6-6" />
          </svg>
        </a>
        <a
          href={SOCIALS.cv}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-secondary"
          aria-label={`${t('hero.cta.cv')} (${lang === 'es' ? 'abre en nueva pestaña' : 'opens in new tab'})`}
        >
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
            <polyline points="7 10 12 15 17 10" />
            <line x1="12" y1="15" x2="12" y2="3" />
          </svg>
          {t('hero.cta.cv')}
        </a>
      </div>

      <ul class="hero-stats" style="--i: 6">
        {stats.map((stat) => (
          <li>
            <span class="stat-num" data-count={stat.value}>0</span>
            <span class="stat-label">{stat.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Right: portrait -->
    <div class="hero-visual" style="--i: 3">
      <figure class="portrait">
        <span class="portrait-frame" aria-hidden="true"></span>

        <picture>
          <source srcset={`${photo}.avif`} type="image/avif" />
          <source srcset={`${photo}.webp`} type="image/webp" />
          <img
            src={`${photo}.png`}
            alt={`Retrato de ${PROFILE.name}`}
            width="440"
            height="540"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="portrait-img"
          />
        </picture>

        <figcaption class="now-card">
          <span class="now-label">
            <span class="now-dot" aria-hidden="true"></span>
            {t('hero.now.label')}
          </span>
          <span class="now-role">{t('hero.now.role')}</span>
        </figcaption>
      </figure>

      <ul class="frame-tech" aria-hidden="true">
        {frameTech.map((tech) => <li>{tech}</li>)}
      </ul>
    </div>
  </div>

  <a href="#stack" class="scroll-cue" aria-label={t('hero.scroll')}>
    <span class="scroll-cue-line" aria-hidden="true"></span>
    <span class="scroll-cue-text">{t('hero.scroll')}</span>
  </a>
</section>

<script>
  // Counts up once, the first time the hero is on screen. Hero renders above
  // the fold, so this fires almost immediately on load — it's still an
  // IntersectionObserver rather than a load listener so it also works if the
  // page is opened mid-scroll (e.g. via a same-page anchor link).
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const nums = document.querySelectorAll<HTMLElement>('.stat-num');

  function countUp(el: HTMLElement) {
    const target = Number(el.dataset.count);
    if (reduced.matches || !target) {
      el.textContent = String(target);
      return;
    }
    const duration = 900;
    const start = performance.now();
    function frame(now: number) {
      const p = Math.min((now - start) / duration, 1);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = String(Math.round(target * eased));
      if (p < 1) requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  }

  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        observer.unobserve(entry.target);
        countUp(entry.target as HTMLElement);
      }
    },
    { threshold: 0.6 }
  );

  nums.forEach((el) => observer.observe(el));
</script>

<style>
  /* ---------------------------------------------------------------
     Entrance is pure CSS: no JS means no blank hero, ever.
     Each child sets --i to place itself in the stagger.
  --------------------------------------------------------------- */
  @keyframes hero-rise {
    from {
      opacity: 0;
      transform: translateY(22px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-content > *,
  .hero-visual {
    animation: hero-rise 0.7s var(--ease-out-soft) both;
    animation-delay: calc(var(--i, 0) * 90ms);
  }

  /* The h1 itself doesn't rise — its letters do, one at a time */
  .hero-name {
    animation: none;
  }

  .hero-greeting {
    animation: hero-rise 0.7s var(--ease-out-soft) 90ms both;
  }

  .name-letters {
    display: inline-block;
    position: relative;
  }

  .letter {
    display: inline-block;
    animation: letter-in 0.7s var(--ease-out-soft) both;
    animation-delay: calc(220ms + var(--l) * 38ms);
  }

  .letter-space {
    display: inline-block;
    width: 0.28em;
  }

  @keyframes letter-in {
    from {
      opacity: 0;
      transform: translateY(0.55em) rotate(6deg);
      filter: blur(6px);
    }
    to {
      opacity: 1;
      transform: none;
      filter: blur(0);
    }
  }

  /* A single light sweep across the name once the letters have landed */
  .name-letters::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      100deg,
      transparent 35%,
      #ffffff40 50%,
      transparent 65%
    );
    background-size: 250% 100%;
    mix-blend-mode: overlay;
    animation: name-shine 1.5s ease-out 1.5s 1 both;
  }

  @keyframes name-shine {
    from { background-position: 180% 0; opacity: 1; }
    to   { background-position: -80% 0; opacity: 0; }
  }

  .hero-section {
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 7rem 3rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 5rem);
  }

  /* ---- Left column ---- */
  .hero-content {
    display: flex;
    flex-direction: column;
    gap: 1.15rem;
  }

  .availability-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.85rem;
    border: 1px solid var(--color-border-accent);
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--color-accent);
    width: fit-content;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    animation: pulse-dot 2.4s ease-in-out infinite;
  }

  @keyframes pulse-dot {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.35; transform: scale(0.6); }
  }

  .hero-name {
    font-family: var(--font-display);
    font-size: clamp(2.3rem, 5.2vw, 4rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .hero-greeting {
    display: block;
    font-family: var(--font-body);
    font-size: clamp(0.95rem, 1.6vw, 1.1rem);
    font-weight: 400;
    color: var(--color-text-faint);
    letter-spacing: 0;
    margin-bottom: 0.4rem;
  }

  .hero-role {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2.2vw, 1.45rem);
    font-weight: 500;
    color: var(--color-text-muted);
    letter-spacing: -0.015em;
  }

  .role-accent {
    color: var(--color-accent);
  }

  .hero-bio {
    font-size: clamp(0.9rem, 1.4vw, 0.98rem);
    color: var(--color-text-muted);
    line-height: 1.75;
    max-width: 52ch;
  }

  /* Chips — hairline separators instead of boxes, less "tag soup" */
  .hero-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem 1rem;
    list-style: none;
    font-size: 0.8rem;
    color: var(--color-text-faint);
  }

  .chip + .chip {
    padding-left: 1rem;
    border-left: 1px solid var(--color-border);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 0.4rem;
  }

  .hero-stats {
    display: flex;
    gap: clamp(1.4rem, 4vw, 2.2rem);
    list-style: none;
    margin-top: 0.6rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--color-border);
  }

  .hero-stats li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .stat-num {
    font-family: var(--font-mono);
    font-size: clamp(1.5rem, 3vw, 1.9rem);
    font-weight: 700;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .stat-label {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  /* ---- Right column: portrait ---- */
  .hero-visual {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.4rem;
  }

  .portrait {
    position: relative;
    width: min(100%, 340px);
    aspect-ratio: 4 / 5;
    isolation: isolate;
  }

  /* Offset accent frame — the graphic idea, no spinning rings */
  .portrait-frame {
    position: absolute;
    inset: 0;
    translate: 14px 14px;
    border: 1px solid var(--color-border-accent);
    border-radius: var(--radius-lg);
    z-index: -1;
  }

  .portrait-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 18%;
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-elevated);
    display: block;
    filter: saturate(0.92) contrast(1.04);
  }

  /* "Now" card overlapping the bottom-left corner */
  .now-card {
    position: absolute;
    left: -0.75rem;
    bottom: 1.4rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.6rem 0.9rem;
    background: color-mix(in srgb, var(--color-bg-elevated) 88%, transparent);
    backdrop-filter: blur(8px);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-card);
    max-width: 15rem;
  }

  .now-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .now-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 8px var(--color-accent);
  }

  .now-role {
    font-size: 0.83rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.35;
  }

  /* Tech marks under the portrait — quiet, typographic */
  .frame-tech {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 0.9rem;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .frame-tech li + li::before {
    content: '/';
    margin-right: 0.9rem;
    color: var(--color-border-strong);
  }

  /* ---- Scroll cue ---- */
  .scroll-cue {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    align-self: center;
    margin-top: 3rem;
    text-decoration: none;
    color: var(--color-text-faint);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: color var(--transition-fast);
  }

  .scroll-cue:hover {
    color: var(--color-accent);
  }

  .scroll-cue-line {
    width: 40px;
    height: 1px;
    background: var(--color-border-strong);
    position: relative;
    overflow: hidden;
  }

  .scroll-cue-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--color-accent);
    animation: cue-sweep 2.2s ease-in-out infinite;
  }

  @keyframes cue-sweep {
    0% { transform: translateX(-100%); }
    60%, 100% { transform: translateX(100%); }
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: 1fr;
      justify-items: center;
      text-align: left;
    }

    .hero-visual {
      order: -1;
    }

    .portrait {
      width: min(100%, 260px);
    }

    .hero-bio {
      max-width: 100%;
    }
  }

  @media (max-width: 520px) {
    .now-card {
      left: 0;
      max-width: 12rem;
    }
  }
</style>
