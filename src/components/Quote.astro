---
import { CONTACT } from '@config/site';
import { type Lang } from '@i18n/ui';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;
const es = lang === 'es';

const whatsappHref = CONTACT.whatsapp ? `https://wa.me/${CONTACT.whatsapp}` : '';
const mailHref = `mailto:${CONTACT.email}?subject=${encodeURIComponent(es ? 'Solicitud de presupuesto' : 'Quote request')}`;

const after = es
  ? [
      ['Te llamo', 'En menos de 24 h, 15 minutos sin compromiso.'],
      ['Recibes la propuesta', 'Precio cerrado y fecha de entrega, por escrito.'],
      ['Empezamos', 'Solo si te convence. La mitad al empezar.'],
    ]
  : [
      ['I call you', 'Within 24 h, 15 minutes, no strings.'],
      ['You get the proposal', 'Fixed price and delivery date, in writing.'],
      ['We start', 'Only if you’re happy. Half up front.'],
    ];
---

<section id="contacto" class="qt">
  <div class="container qt-grid">
    <div class="qt-info" data-reveal>
      <p class="section-eyebrow">
        <span class="section-index">06</span>
        <span class="section-label">{es ? 'Contacto' : 'Contact'}</span>
      </p>
      <h2 class="section-title">{es ? 'Cuéntame qué necesitas.' : 'Tell me what you need.'}</h2>
      <p class="qt-lead">
        {es
          ? 'Te respondo en menos de 24 h laborables con una propuesta o una llamada.'
          : 'I reply within one working day with a proposal or a call.'}
      </p>

      <div class="qt-cards">
        <div class="qt-card qt-dark">
          <strong>24 h</strong>
          <span>{es ? 'tiempo máximo de respuesta' : 'maximum reply time'}</span>
        </div>
        {whatsappHref && (
          <a class="qt-card qt-wa" href={whatsappHref} target="_blank" rel="noopener">
            <small>WhatsApp</small>
            <span>{CONTACT.whatsappLabel || CONTACT.whatsapp}</span>
          </a>
        )}
        <div class="qt-card">
          <small>{es ? 'Horario' : 'Hours'}</small>
          <span>{CONTACT.hours[lang]}</span>
        </div>
      </div>

      <div class="qt-after">
        <p class="qt-kicker">{es ? 'Qué pasa después' : 'What happens next'}</p>
        <ol role="list">
          {after.map(([t, d], i) => (
            <li>
              <span>{i + 1}</span>
              <div><strong>{t}</strong><p>{d}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="qt-form-wrap" data-reveal style="--delay: 120ms">
      <div class="qt-mail">
        <p class="qt-kicker">{es ? 'Escríbeme' : 'Write to me'}</p>
        <p class="qt-mail-lead">
          {es
            ? 'Cuéntame tu negocio, qué necesitas y para cuándo. Te contesto con una propuesta por escrito.'
            : 'Tell me about your business, what you need and when. I’ll reply with a written proposal.'}
        </p>

        {CONTACT.email && (
          <>
            <a class="qt-mail-addr" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
            <div class="qt-mail-actions">
              <a
                id="qt-mail-link"
                class="btn btn-primary"
                href={mailHref}
                data-base-href={mailHref}
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m3 7 9 6 9-6" />
                </svg>
                {es ? 'Escribir un email' : 'Send an email'}
              </a>
              <button
                type="button"
                class="btn btn-ghost"
                data-copy={CONTACT.email}
                data-done={es ? '¡Copiado!' : 'Copied!'}
              >
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="9" y="9" width="12" height="12" rx="2" />
                  <path d="M5 15V5a2 2 0 0 1 2-2h10" />
                </svg>
                <span>{es ? 'Copiar dirección' : 'Copy address'}</span>
              </button>
            </div>
            <p class="qt-mail-note">
              {es ? '¿No se abre tu app de correo? Copia la dirección y escríbeme desde donde prefieras.' : 'Mail app not opening? Copy the address and write from wherever you like.'}
            </p>
          </>
        )}

        {(whatsappHref || CONTACT.bookingUrl) && (
          <div class="qt-mail-more">
            {whatsappHref && <a class="btn btn-ghost" href={whatsappHref} target="_blank" rel="noopener">WhatsApp</a>}
            {CONTACT.bookingUrl && (
              <a class="btn btn-ghost" href={CONTACT.bookingUrl} target="_blank" rel="noopener">
                {es ? 'Reservar llamada de 15 min' : 'Book a 15-min call'}
              </a>
            )}
          </div>
        )}
      </div>
    </div>
  </div>
  <div class="container">
    <div class="qt-band" data-reveal>
      <div>
        <p class="qt-band-title">{es ? 'Tu negocio online, listo en semanas. No en meses.' : 'Your business online in weeks, not months.'}</p>
        <p class="qt-band-sub">{es ? 'Primera llamada gratis y sin compromiso.' : 'First call free, no strings.'}</p>
      </div>
      <div class="qt-band-ctas">
        <a href="#contacto" class="btn btn-primary">{es ? 'Pedir presupuesto' : 'Get a quote'}</a>
        <a href="#presupuesto" class="btn btn-ghost">{es ? 'Arma tu proyecto' : 'Build your project'}</a>
      </div>
    </div>
  </div>
</section>

<script>
  // Calculator / service buttons hand their choice over as a prefilled email.
  const link = document.querySelector<HTMLAnchorElement>('#qt-mail-link');
  window.addEventListener('quote:prefill', (e) => {
    if (!link?.dataset.baseHref) return;
    const { subject, body } = (e as CustomEvent<{ subject: string; body?: string }>).detail;
    const params = [`subject=${encodeURIComponent(subject)}`];
    if (body) params.push(`body=${encodeURIComponent(body)}`);
    link.href = `${link.dataset.baseHref.split('?')[0]}?${params.join('&')}`;
  });

  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
    const label = btn.querySelector('span');
    const original = label?.textContent ?? '';
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy ?? '');
      } catch {
        const ta = document.createElement('textarea');
        ta.value = btn.dataset.copy ?? '';
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        ta.remove();
      }
      if (label) label.textContent = btn.dataset.done ?? original;
      window.setTimeout(() => label && (label.textContent = original), 2000);
    });
  });
</script>

<style>
  .qt-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .qt-lead {
    margin-top: 1rem;
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .qt-cards {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .qt-card {
    display: grid;
    gap: 0.2rem;
    align-content: end;
    min-height: 92px;
    padding: 1rem 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-bg-elevated);
    text-decoration: none;
    color: var(--color-text);
    font-size: 0.88rem;
    word-break: break-word;
  }

  a.qt-card:hover {
    border-color: var(--color-border-accent);
  }

  .qt-card small {
    font-size: 0.72rem;
    color: var(--color-text-faint);
  }

  .qt-dark {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: var(--color-on-accent);
  }

  .qt-dark strong {
    font-family: var(--font-display);
    font-size: 2rem;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .qt-dark span {
    font-size: 0.8rem;
  }

  .qt-wa {
    border-color: #25d36655;
    background: #25d36612;
  }

  .qt-after {
    margin-top: 1rem;
    padding: 1.2rem 1.3rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .qt-kicker {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .qt-after ol {
    display: grid;
    gap: 0.9rem;
    margin-top: 1rem;
    list-style: none;
  }

  .qt-after li {
    display: flex;
    gap: 0.8rem;
  }

  .qt-after li > span {
    display: grid;
    place-items: center;
    flex: none;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--color-text);
    color: var(--color-bg);
    font-size: 0.75rem;
    font-weight: 700;
  }

  .qt-after strong {
    font-size: 0.9rem;
  }

  .qt-after p {
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  .qt-mail {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at 100% 0%, #1f4fd114, transparent 55%),
      var(--color-bg-elevated);
    box-shadow: var(--shadow-card);
  }

  .qt-mail-lead {
    color: var(--color-text-muted);
    line-height: 1.7;
  }

  .qt-mail-addr {
    max-width: 100%;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 4.6vw, 1.85rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: var(--color-accent);
    text-decoration: none;
    overflow-wrap: anywhere;
    border-bottom: 2px solid var(--color-border-accent);
    transition: border-color var(--transition-fast);
  }

  .qt-mail-addr:hover {
    border-color: var(--color-accent);
  }

  .qt-mail-actions,
  .qt-mail-more {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .qt-mail-note {
    font-size: 0.8rem;
    color: var(--color-text-faint);
  }
  .qt-band {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-top: clamp(3rem, 6vw, 5rem);
    padding: clamp(1.75rem, 4vw, 3rem);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(circle at 85% 20%, #1f4fd126, transparent 45%),
      var(--color-bg-card);
    border: 1px solid var(--color-border-accent);
  }

  .qt-band-title {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.6vw, 2.4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
    max-width: 18ch;
  }

  .qt-band-sub {
    margin-top: 0.5rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }

  .qt-band-ctas {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  @media (max-width: 860px) {
    .qt-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .qt-cards {
      grid-template-columns: 1fr;
    }
  }
</style>
