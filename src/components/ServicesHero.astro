---
import { BASE_URL, PROFILE } from '@config/site';
import { type Lang } from '@i18n/ui';
import { sectors } from '@data/services';
import SocialLinks from '@components/SocialLinks.astro';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;
const es = lang === 'es';

const photo = `${BASE_URL}/images/ismael-retrato`;
const shot = `${BASE_URL}/images/dtf-al-metro`;

const pills = es
  ? ['Precio cerrado por escrito', 'El código es tuyo', 'Respuesta en 24 h']
  : ['Fixed price in writing', 'You own the code', 'Reply within 24 h'];
---

<section id="hero" class="sh">
  <div class="container sh-grid">
    <div class="sh-copy">
      <p class="sh-status" style="--i: 0">
        <span class="sh-dot" aria-hidden="true"></span>
        {es ? 'Disponible para nuevos proyectos · Sevilla' : 'Available for new projects · Seville'}
      </p>

      <h1 class="sh-title" style="--i: 1">
        {es ? 'Webs y tiendas online' : 'Websites and online shops'}
        <span class="sh-accent">{es ? 'que trabajan por ti.' : 'that work for you.'}</span>
      </h1>

      <p class="sh-lead" style="--i: 2">
        {es ? (
          <>Soy <strong>Ismael</strong>. Diseño, programo y publico tu web, tu tienda con pagos o tu panel de gestión, y me aseguro de que sea segura. Sin agencias ni intermediarios: <strong>me escribes a mí y te respondo yo.</strong></>
        ) : (
          <>I’m <strong>Ismael</strong>. I design, build and launch your website, your shop with payments or your admin panel, and make sure it’s secure. No agencies, no middlemen: <strong>you write to me and I answer.</strong></>
        )}
      </p>

      <div class="sh-ctas" style="--i: 3">
        <a href="#contacto" class="btn btn-primary">
          {es ? 'Pedir presupuesto' : 'Get a quote'}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </a>
        <a href="#trabajos" class="btn btn-ghost">{es ? 'Ver trabajos' : 'See my work'}</a>
      </div>

      <ul class="sh-pills" role="list" style="--i: 4">
        {pills.map((p) => <li>{p}</li>)}
      </ul>

      <div class="sh-social" style="--i: 5">
        <p>{es ? 'Cotillea mi trabajo y mi día a día' : 'Have a look at my work and my day-to-day'}</p>
        <SocialLinks variant="hero" lang={lang} />
      </div>
    </div>

    <!-- The person you'll be talking to, front and centre -->
    <div class="sh-visual">
      <div class="sh-halo" aria-hidden="true"></div>

      <figure class="sh-photo">
        <div class="sh-frame">
          <picture>
            <source srcset={`${photo}.avif`} type="image/avif" />
            <source srcset={`${photo}.webp`} type="image/webp" />
            <img
              src={`${photo}.jpg`}
              alt={es ? 'Ismael Piña, de noche en Sevilla' : 'Ismael Piña at night in Seville'}
              width="960"
              height="1200"
              fetchpriority="high"
            />
          </picture>
        </div>
        <figcaption>
          <span class="sh-cap-name">{PROFILE.name}</span>
          <span class="sh-cap-role">{PROFILE.role[lang]}<span class="sh-cap-loc"> · {PROFILE.location.split(',')[0]}</span></span>
        </figcaption>
      </figure>

      <a href="#trabajos" class="sh-work">
        <picture>
          <source srcset={`${shot}.avif`} type="image/avif" />
          <source srcset={`${shot}.webp`} type="image/webp" />
          <img src={`${shot}.png`} alt="" width="112" height="70" loading="lazy" />
        </picture>
        <span>
          <small>{es ? 'Último trabajo' : 'Latest work'}</small>
          <strong>dtfalmetro.es</strong>
        </span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17 17 7M17 7H7M17 7v10" /></svg>
      </a>
    </div>
  </div>

  <div class="sh-marquee" aria-label={es ? 'Sectores' : 'Industries'}>
    <ul role="list">
      {[...sectors, ...sectors].map((s, i) => (
        <li aria-hidden={i >= sectors.length ? 'true' : undefined}>{s[lang]}</li>
      ))}
    </ul>
  </div>
</section>
<style>
  .sh {
    padding-top: calc(var(--nav-h) + clamp(2rem, 5vw, 4rem));
    padding-bottom: 0;
  }

  .sh-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  /* ---- Entrance: one calm cascade on load, nothing after ---- */
  .sh-copy > * {
    animation: sh-rise 0.9s var(--ease-out-soft) both;
    animation-delay: calc(var(--i, 0) * 90ms + 80ms);
  }

  .sh-visual {
    animation: sh-fade 1.4s ease 0.25s both;
  }

  @keyframes sh-rise {
    from { opacity: 0; transform: translateY(14px); }
    to   { opacity: 1; transform: none; }
  }

  @keyframes sh-fade {
    from { opacity: 0; }
    to   { opacity: 1; }
  }

  .sh-status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.5rem;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }

  /* A quiet light that slowly breathes, not a blinking ping */
  .sh-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-accent) 16%, transparent);
    animation: sh-breathe 4s ease-in-out infinite;
  }

  @keyframes sh-breathe {
    50% { opacity: 0.45; box-shadow: 0 0 0 7px color-mix(in srgb, var(--color-accent) 5%, transparent); }
  }

  .sh-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5.6vw, 4.2rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .sh-accent {
    display: block;
    color: var(--color-accent);
  }

  /* A slow band of light crosses the accent line every so often */
  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .sh-accent {
      background-image: linear-gradient(
        100deg,
        var(--color-accent) 0%,
        var(--color-accent) 40%,
        color-mix(in srgb, var(--color-accent) 45%, var(--color-text)) 50%,
        var(--color-accent) 60%,
        var(--color-accent) 100%
      );
      background-size: 260% 100%;
      background-position: 110% 0;
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: transparent;
    }

    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
      .sh-accent {
        animation: sh-sheen 11s ease-in-out 2.4s infinite;
      }
    }
  }

  @keyframes sh-sheen {
    0%        { background-position: 110% 0; }
    45%, 100% { background-position: -10% 0; }
  }

  .sh-lead {
    margin-top: 1.4rem;
    max-width: 54ch;
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .sh-lead strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .sh-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  /* Plain facts with a small marker: reads as a statement, not as tags */
  .sh-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.4rem;
    margin-top: 1.5rem;
    list-style: none;
  }

  .sh-pills li {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.78rem;
    letter-spacing: 0.02em;
    color: var(--color-text-muted);
  }

  .sh-pills li::before {
    content: '';
    width: 14px;
    height: 1px;
    background: var(--color-accent);
  }
  .sh-social {
    margin-top: 2rem;
    padding-top: 1.4rem;
    border-top: 1px solid var(--color-border);
  }

  .sh-social > p {
    margin-bottom: 0.75rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  /* ---- Portrait: an editorial frame, level and still ---- */
  .sh-visual {
    position: relative;
    justify-self: center;
    width: min(100%, 420px);
    padding: 0.5rem 0 0;
    isolation: isolate;
  }

  /* Soft light behind the photo that slowly swells and settles */
  .sh-halo {
    position: absolute;
    inset: -14% -22% 4%;
    z-index: -1;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--color-accent) 20%, transparent),
      transparent 72%
    );
    pointer-events: none;
  }

  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .sh-halo {
      animation: sh-halo 12s ease-in-out infinite;
    }
  }

  @keyframes sh-halo {
    50% { transform: scale(1.08); opacity: 0.7; }
  }

  .sh-photo {
    position: relative;
  }

  .sh-frame {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    border: 1px solid var(--color-border-strong);
    box-shadow: var(--shadow-photo);
  }

  /* A second outline, offset like a registration mark */
  .sh-photo::before {
    content: '';
    position: absolute;
    inset: 0;
    translate: 14px 14px;
    border: 1px solid var(--color-border-accent);
    border-radius: 20px;
    pointer-events: none;
    z-index: -1;
    transition: translate 700ms var(--ease-out-soft);
  }

  @media (hover: hover) {
    .sh-visual:hover .sh-photo::before {
      translate: 20px 20px;
    }
  }

  .sh-frame img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    animation: sh-settle 1.8s var(--ease-out-soft) 0.2s both;
  }

  @keyframes sh-settle {
    from { scale: 1.07; }
    to   { scale: 1; }
  }

  .sh-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, #060a14a6, transparent 38%);
    pointer-events: none;
  }

  /* On wide screens the photo drifts a little against the scroll */
  @supports (animation-timeline: view()) {
    @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
      .sh-frame img {
        animation:
          sh-settle 1.8s var(--ease-out-soft) 0.2s both,
          sh-drift linear both;
        animation-timeline: auto, view();
        animation-range: normal, exit 0% exit 100%;
      }

      @keyframes sh-drift {
        to { translate: 0 28px; }
      }
    }
  }

  .sh-photo figcaption {
    position: absolute;
    left: 1.1rem;
    right: 1.1rem;
    bottom: 0.95rem;
    display: grid;
    gap: 0.1rem;
    color: #f2f5fb;
  }

  .sh-cap-name {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .sh-cap-role {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f2f5fbc2;
  }

  /* ---- Latest work: a quiet line under the photo ---- */
  .sh-work {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.6rem;
    padding: 0.5rem 0.9rem 0.5rem 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-bg-card) 70%, transparent);
    text-decoration: none;
    color: var(--color-text);
    transition: border-color var(--transition-base), background var(--transition-base);
  }

  @media (hover: hover) {
    .sh-work:hover {
      border-color: var(--color-border-accent);
      background: var(--color-bg-card);
    }
  }

  .sh-work img {
    display: block;
    width: 56px;
    height: 35px;
    border-radius: 6px;
    object-fit: cover;
    object-position: top;
  }

  .sh-work > span {
    flex: 1;
  }

  .sh-work small {
    display: block;
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .sh-work strong {
    font-size: 0.85rem;
    font-weight: 600;
  }

  .sh-work svg {
    color: var(--color-accent);
  }

  /* ---- Marquee ---- */
  .sh-marquee {
    margin-top: clamp(3rem, 6vw, 5rem);
    border-block: 1px solid var(--color-border);
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
  }

  .sh-marquee ul {
    display: flex;
    width: max-content;
    list-style: none;
    animation: sh-marquee 60s linear infinite;
  }

  .sh-marquee li {
    padding: 1.1rem 2.2rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-faint);
    white-space: nowrap;
  }

  .sh-marquee li::after {
    content: '•';
    margin-left: 4.4rem;
    color: var(--color-accent-deep);
  }

  @keyframes sh-marquee {
    to { transform: translateX(-50%); }
  }

  @media (max-width: 900px) {
    .sh-grid {
      grid-template-columns: 1fr;
    }
    /* On phones the face comes first: that's the hook */
    .sh-visual {
      order: -1;
      width: min(80%, 360px);
      margin-bottom: 0.5rem;
    }
    .sh-halo {
      inset: -10% -14% 8%;
    }
    .sh-photo::before {
      translate: 10px 10px;
    }
    /* The status line above already says where I am */
    .sh-cap-loc {
      display: none;
    }
    .sh-social {
      text-align: center;
    }
    .sh-pills {
      justify-content: center;
    }
  }
</style>