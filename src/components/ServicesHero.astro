---
import { BASE_URL, PROFILE } from '@config/site';
import { type Lang } from '@i18n/ui';
import { sectors } from '@data/services';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;
const es = lang === 'es';

const photo = `${BASE_URL}/images/IsmaelFoto`;
const shot = `${BASE_URL}/images/dtf-al-metro`;

const pills = es
  ? ['Precio cerrado por escrito', 'El código es tuyo', 'Respuesta en 24 h']
  : ['Fixed price in writing', 'You own the code', 'Reply within 24 h'];
---

<section id="hero" class="sh">
  <div class="container sh-grid">
    <div class="sh-copy">
      <p class="sh-hello">
        <picture>
          <source srcset={`${photo}.avif`} type="image/avif" />
          <source srcset={`${photo}.webp`} type="image/webp" />
          <img src={`${photo}.png`} alt="" width="28" height="28" />
        </picture>
        <span>
          {es ? 'Hola, soy' : 'Hi, I’m'} <strong>{PROFILE.name.split(' ').slice(0, 2).join(' ')}</strong> ·
          {es ? ' desarrollador web en Sevilla' : ' web developer in Seville'}
        </span>
      </p>

      <h1 class="sh-title">
        {es ? 'Webs y tiendas online' : 'Websites and online shops'}
        <span class="sh-accent">{es ? 'que trabajan por ti.' : 'that work for you.'}</span>
      </h1>

      <p class="sh-lead">
        {
          es
            ? 'Diseño, programo y publico tu web, tu tienda con pagos o tu panel de gestión, y me aseguro de que sea segura. Un solo interlocutor, de la idea a producción.'
            : 'I design, build and launch your website, your shop with payments or your admin panel, and make sure it’s secure. One person, from idea to production.'
        }
      </p>

      <div class="sh-ctas">
        <a href="#contacto" class="btn btn-primary">
          {es ? 'Pedir presupuesto' : 'Get a quote'}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </a>
        <a href="#trabajos" class="btn btn-ghost">{es ? 'Ver trabajos' : 'See my work'}</a>
      </div>

      <ul class="sh-pills" role="list">
        {pills.map((p) => (
          <li>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
            {p}
          </li>
        ))}
      </ul>
    </div>

    <!-- Live work in a browser frame, with the bits a client actually cares about floating around it -->
    <div class="sh-visual" aria-hidden="true">
      <div class="sh-browser">
        <div class="sh-bar">
          <span></span><span></span><span></span>
          <em>dtfalmetro.es</em>
        </div>
        <picture>
          <source srcset={`${shot}.avif`} type="image/avif" />
          <source srcset={`${shot}.webp`} type="image/webp" />
          <img src={`${shot}.png`} alt="" width="700" height="438" fetchpriority="high" />
        </picture>
      </div>

      <div class="sh-float sh-float-order">
        <span class="sh-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2" /><path d="M2 10h20" /></svg>
        </span>
        <span>
          <strong>{es ? 'Pago con tarjeta' : 'Card payment'}</strong>
          <small>{es ? 'Pedido confirmado' : 'Order confirmed'}</small>
        </span>
        <span class="sh-ok">✓</span>
      </div>

      <div class="sh-float sh-float-sec">
        <span class="sh-icon">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" /><path d="m9 12 2 2 4-4" /></svg>
        </span>
        <span>
          <strong>{es ? 'Auditada' : 'Security-tested'}</strong>
          <small>OWASP Top 10</small>
        </span>
      </div>

      <div class="sh-float sh-float-client">
        <span class="sh-dot"></span>
        {es ? 'Cliente real · en producción' : 'Real client · live'}
      </div>
    </div>
  </div>

  <div class="sh-marquee" aria-label={es ? 'Sectores' : 'Industries'}>
    <ul role="list">
      {[...sectors, ...sectors].map((s, i) => (
        <li aria-hidden={i >= sectors.length ? 'true' : undefined}>{s[lang]}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .sh {
    padding-top: calc(64px + clamp(2.5rem, 6vw, 5rem));
    padding-bottom: 0;
  }

  .sh-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .sh-hello {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0.85rem 0.3rem 0.3rem;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    background: var(--color-bg-elevated);
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-bottom: 1.6rem;
  }

  .sh-hello img {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    display: block;
  }

  .sh-hello strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .sh-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5.6vw, 4.2rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .sh-accent {
    display: block;
    color: var(--color-accent);
  }

  .sh-lead {
    margin-top: 1.4rem;
    max-width: 52ch;
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .sh-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .sh-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.4rem;
    list-style: none;
  }

  .sh-pills li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .sh-pills svg {
    color: var(--color-accent);
  }

  /* ---- Visual ---- */
  .sh-visual {
    position: relative;
    padding: 1.5rem 0 2.5rem;
  }

  .sh-browser {
    border-radius: var(--radius-lg);
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    background: var(--color-bg-elevated);
    box-shadow: 0 30px 80px #00000080, 0 0 60px #a3e63512;
    transform: perspective(1400px) rotateY(-6deg) rotateX(2deg);
  }

  .sh-bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 0.6rem 0.8rem;
    border-bottom: 1px solid var(--color-border);
  }

  .sh-bar span {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--color-border-strong);
  }

  .sh-bar em {
    margin-left: 0.6rem;
    flex: 1;
    max-width: 16rem;
    padding: 0.18rem 0.7rem;
    border-radius: var(--radius-sm);
    background: var(--color-bg-sunken);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-style: normal;
    color: var(--color-text-muted);
  }

  .sh-browser img {
    display: block;
    width: 100%;
    height: auto;
  }

  .sh-float {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.65rem 0.85rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--color-border-strong);
    background: color-mix(in srgb, var(--color-bg-card) 92%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow-card);
    font-size: 0.78rem;
    animation: sh-bob 6s ease-in-out infinite;
  }

  .sh-float strong {
    display: block;
    font-weight: 600;
    color: var(--color-text);
  }

  .sh-float small {
    display: block;
    color: var(--color-text-faint);
    font-size: 0.7rem;
  }

  .sh-icon {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-sm);
    background: #a3e6351f;
    color: var(--color-accent);
  }

  .sh-ok {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--color-accent);
    color: #0a0a0b;
    font-size: 0.7rem;
    font-weight: 800;
  }

  .sh-float-order {
    left: -1.5rem;
    bottom: 0.5rem;
  }

  .sh-float-sec {
    right: -1rem;
    top: 0;
    animation-delay: -2s;
  }

  .sh-float-client {
    right: 1.5rem;
    bottom: -0.5rem;
    gap: 0.5rem;
    padding: 0.45rem 0.8rem;
    border-radius: 999px;
    color: var(--color-text-muted);
    animation-delay: -4s;
  }

  .sh-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 8px var(--color-accent);
  }

  @keyframes sh-bob {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -8px; }
  }

  /* ---- Marquee ---- */
  .sh-marquee {
    margin-top: clamp(3rem, 6vw, 5rem);
    border-block: 1px solid var(--color-border);
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
  }

  .sh-marquee ul {
    display: flex;
    width: max-content;
    list-style: none;
    animation: sh-marquee 40s linear infinite;
  }

  .sh-marquee li {
    padding: 1.1rem 2.2rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-faint);
    white-space: nowrap;
  }

  .sh-marquee li::after {
    content: '•';
    margin-left: 4.4rem;
    color: var(--color-accent-deep);
  }

  @keyframes sh-marquee {
    to { transform: translateX(-50%); }
  }

  @media (max-width: 900px) {
    .sh-grid {
      grid-template-columns: 1fr;
    }
    .sh-browser {
      transform: none;
    }
    .sh-float-order {
      left: 0.5rem;
    }
    .sh-float-sec {
      right: 0.5rem;
    }
  }

  @media (max-width: 520px) {
    .sh-float-sec,
    .sh-float-client {
      display: none;
    }
  }
</style>
