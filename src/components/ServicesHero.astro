---
import { BASE_URL } from '@config/site';
import { type Lang } from '@i18n/ui';
import { sectors } from '@data/services';
import SocialLinks from '@components/SocialLinks.astro';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;
const es = lang === 'es';

const photo = `${BASE_URL}/images/ismael-retrato`;
const shot = `${BASE_URL}/images/dtf-al-metro`;

const pills = es
  ? ['Precio cerrado por escrito', 'El código es tuyo', 'Respuesta en 24 h']
  : ['Fixed price in writing', 'You own the code', 'Reply within 24 h'];
---

<section id="hero" class="sh">
  <div class="container sh-grid">
    <div class="sh-copy">
      <p class="sh-status">
        <span class="sh-pulse" aria-hidden="true"></span>
        {es ? 'Disponible para nuevos proyectos · Sevilla' : 'Available for new projects · Seville'}
      </p>

      <h1 class="sh-title">
        {es ? 'Webs y tiendas online' : 'Websites and online shops'}
        <span class="sh-accent">{es ? 'que trabajan por ti.' : 'that work for you.'}</span>
      </h1>

      <p class="sh-lead">
        {es ? (
          <>Soy <strong>Ismael</strong>. Diseño, programo y publico tu web, tu tienda con pagos o tu panel de gestión, y me aseguro de que sea segura. Sin agencias ni intermediarios: <strong>me escribes a mí y te respondo yo.</strong></>
        ) : (
          <>I’m <strong>Ismael</strong>. I design, build and launch your website, your shop with payments or your admin panel, and make sure it’s secure. No agencies, no middlemen: <strong>you write to me and I answer.</strong></>
        )}
      </p>

      <div class="sh-ctas">
        <a href="#contacto" class="btn btn-primary">
          {es ? 'Pedir presupuesto' : 'Get a quote'}
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
        </a>
        <a href="#trabajos" class="btn btn-ghost">{es ? 'Ver trabajos' : 'See my work'}</a>
      </div>

      <ul class="sh-pills" role="list">
        {pills.map((p) => (
          <li>
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg>
            {p}
          </li>
        ))}
      </ul>

      <div class="sh-social">
        <p>{es ? 'Cotillea mi trabajo y mi día a día' : 'Have a look at my work and my day-to-day'}</p>
        <SocialLinks variant="hero" lang={lang} />
      </div>
    </div>

    <!-- The person you'll be talking to, front and centre -->
    <div class="sh-visual">
      <figure class="sh-photo">
        <picture>
          <source srcset={`${photo}.avif`} type="image/avif" />
          <source srcset={`${photo}.webp`} type="image/webp" />
          <img
            src={`${photo}.jpg`}
            alt={es ? 'Ismael Piña, de noche en Sevilla' : 'Ismael Piña at night in Seville'}
            width="960"
            height="1200"
            fetchpriority="high"
          />
        </picture>
      </figure>

      <p class="sh-sticker" aria-hidden="true">
        {es ? '¡Hola! Soy Ismael' : 'Hi! I’m Ismael'} <span class="sh-wave">👋</span>
      </p>

      <p class="sh-note" aria-hidden="true">
        <span>📍 {es ? 'Sevilla' : 'Seville'}</span>
        {es ? 'Hablas conmigo, no con una agencia' : 'You talk to me, not an agency'}
      </p>

      <a href="#trabajos" class="sh-work">
        <picture>
          <source srcset={`${shot}.avif`} type="image/avif" />
          <source srcset={`${shot}.webp`} type="image/webp" />
          <img src={`${shot}.png`} alt="" width="112" height="70" loading="lazy" />
        </picture>
        <span>
          <small>{es ? 'Último trabajo' : 'Latest work'}</small>
          <strong>dtfalmetro.es</strong>
        </span>
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M7 17 17 7M17 7H7M17 7v10" /></svg>
      </a>
    </div>
  </div>

  <div class="sh-marquee" aria-label={es ? 'Sectores' : 'Industries'}>
    <ul role="list">
      {[...sectors, ...sectors].map((s, i) => (
        <li aria-hidden={i >= sectors.length ? 'true' : undefined}>{s[lang]}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  .sh {
    padding-top: calc(var(--nav-h) + clamp(2rem, 5vw, 4rem));
    padding-bottom: 0;
  }

  .sh-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .sh-status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--color-border-accent);
    border-radius: 999px;
    background: #1f4fd10f;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .sh-pulse {
    position: relative;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .sh-pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--color-accent);
    animation: sh-ping 1.8s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes sh-ping {
    75%, 100% { transform: scale(2.6); opacity: 0; }
  }

  .sh-title {
    font-family: var(--font-display);
    font-size: clamp(2.4rem, 5.6vw, 4.2rem);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.045em;
    text-wrap: balance;
  }

  .sh-accent {
    display: block;
    color: var(--color-accent);
  }

  .sh-lead {
    margin-top: 1.4rem;
    max-width: 54ch;
    font-size: 1.02rem;
    line-height: 1.7;
    color: var(--color-text-muted);
  }

  .sh-lead strong {
    color: var(--color-text);
    font-weight: 600;
  }

  .sh-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .sh-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.25rem;
    list-style: none;
  }

  .sh-pills li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    font-size: 0.78rem;
    color: var(--color-text-muted);
  }

  .sh-pills svg {
    color: var(--color-accent);
  }

  .sh-social {
    margin-top: 2rem;
    padding-top: 1.4rem;
    border-top: 1px dashed var(--color-border-strong);
  }

  .sh-social > p {
    margin-bottom: 0.75rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  /* ---- Portrait ---- */
  .sh-visual {
    position: relative;
    justify-self: center;
    width: min(100%, 440px);
    padding: 1.5rem 0 2.5rem;
  }

  .sh-photo {
    position: relative;
    border-radius: 28px;
    overflow: hidden;
    rotate: 2.5deg;
    border: 1px solid var(--color-border-strong);
    box-shadow:
      0 40px 80px #0f1e3333,
      0 0 0 6px var(--color-bg),
      0 0 0 7px var(--color-border-accent),
      0 0 80px #1f4fd11f;
    transition: rotate 500ms var(--ease-out-soft), scale 500ms var(--ease-out-soft);
  }

  .sh-visual:hover .sh-photo {
    rotate: 0deg;
    scale: 1.015;
  }

  .sh-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, #0f1e3359, transparent 35%);
    pointer-events: none;
  }

  .sh-photo img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
  }

  .sh-sticker {
    position: absolute;
    top: 0.2rem;
    left: -1.6rem;
    z-index: 2;
    padding: 0.55rem 1rem;
    border-radius: 14px;
    background: var(--color-cta);
    color: var(--color-on-accent);
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    rotate: -7deg;
    box-shadow: 0 12px 30px #f26b3a4d;
  }

  .sh-wave {
    display: inline-block;
    transform-origin: 70% 70%;
    animation: sh-wave 2.6s ease-in-out infinite;
  }

  @keyframes sh-wave {
    0%, 60%, 100% { rotate: 0deg; }
    10%, 30% { rotate: 14deg; }
    20%, 40% { rotate: -8deg; }
  }

  .sh-note {
    position: absolute;
    right: -1.2rem;
    bottom: 5.5rem;
    z-index: 2;
    display: grid;
    gap: 0.1rem;
    max-width: 13.5rem;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-bg-card) 90%, transparent);
    backdrop-filter: blur(10px);
    box-shadow: var(--shadow-card);
    font-size: 0.8rem;
    line-height: 1.35;
    color: var(--color-text);
    rotate: 3deg;
  }

  .sh-note span {
    font-size: 0.72rem;
    color: var(--color-text-faint);
  }

  .sh-work {
    position: absolute;
    left: -2rem;
    bottom: 0.4rem;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.45rem 0.8rem 0.45rem 0.45rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-bg-card);
    box-shadow: var(--shadow-card);
    text-decoration: none;
    color: var(--color-text);
    transition: border-color var(--transition-fast), translate var(--transition-fast);
  }

  .sh-work:hover {
    border-color: var(--color-accent);
    translate: 0 -3px;
  }

  .sh-work img {
    display: block;
    width: 56px;
    height: 35px;
    border-radius: 6px;
    object-fit: cover;
    object-position: top;
  }

  .sh-work small {
    display: block;
    font-size: 0.66rem;
    color: var(--color-text-faint);
  }

  .sh-work strong {
    font-size: 0.82rem;
  }

  .sh-work svg {
    color: var(--color-accent);
  }

  /* ---- Marquee ---- */
  .sh-marquee {
    margin-top: clamp(3rem, 6vw, 5rem);
    border-block: 1px solid var(--color-border);
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, #000 10%, #000 90%, transparent);
  }

  .sh-marquee ul {
    display: flex;
    width: max-content;
    list-style: none;
    animation: sh-marquee 40s linear infinite;
  }

  .sh-marquee li {
    padding: 1.1rem 2.2rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 500;
    color: var(--color-text-faint);
    white-space: nowrap;
  }

  .sh-marquee li::after {
    content: '•';
    margin-left: 4.4rem;
    color: var(--color-accent-deep);
  }

  @keyframes sh-marquee {
    to { transform: translateX(-50%); }
  }

  @media (max-width: 900px) {
    .sh-grid {
      grid-template-columns: 1fr;
    }
    /* On phones the face comes first: that's the hook */
    .sh-visual {
      order: -1;
      width: min(78%, 360px);
      margin-bottom: 0.5rem;
    }
    .sh-sticker {
      left: -1rem;
    }
    .sh-note {
      right: -1rem;
      bottom: 4.5rem;
    }
    .sh-work {
      left: -1rem;
    }
  }

  @media (max-width: 420px) {
    .sh-note {
      display: none;
    }
  }
</style>
