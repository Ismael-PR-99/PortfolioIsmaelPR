---
import projects from '@data/projects.json';
import { BASE_URL, SOCIALS } from '@config/site';
import { type Lang } from '@i18n/ui';
import { useTranslations } from '@i18n/utils';

interface Props { lang?: Lang; }
const { lang = 'es' } = Astro.props;
const t = useTranslations(lang);

type Localised = { es: string; en: string };

interface Project {
  id: string;
  number: string;
  category: string;
  title: string;
  description: string;
  longDescription: string;
  image: string;
  year?: string;
  role?: Localised;
  context?: Localised;
  tags: string[];
  liveUrl: string;
  githubUrl: string;
  featured: boolean;
  status: string;
}

const typedProjects = projects as Project[];

// Strip the extension so <picture> can offer avif/webp/png of the same asset.
const imageBase = (image: string) => `${BASE_URL}${image.replace(/\.\w+$/, '')}`;
---

<section id="projects" class="projects-section">
  <div class="container">
    <header class="section-head" data-reveal>
      <div>
        <p class="section-eyebrow">
          <span class="section-index">03</span>
          <span class="section-label">{t('projects.label')}</span>
        </p>
        <h2 class="section-title">{t('projects.title')}</h2>
      </div>
      <p class="section-subtitle">{t('projects.subtitle')}</p>
    </header>
  </div>

  {
    typedProjects.map((project, i) => {
      const specs = [
        project.role && { label: t('projects.spec.role'), value: project.role[lang] },
        project.year && { label: t('projects.spec.year'), value: project.year },
        project.context && { label: t('projects.spec.context'), value: project.context[lang] },
      ].filter(Boolean) as { label: string; value: string }[];

      return (
        <article class="case" data-reveal style={`--delay: ${i * 90}ms`}>
          {/* Full-bleed shot: the screenshot is the hero of the section */}
          <a
            href={project.liveUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="case-shot"
            data-spotlight
            aria-label={
              lang === 'es'
                ? `Ver ${project.title} en producción (abre en nueva pestaña)`
                : `View ${project.title} live (opens in new tab)`
            }
          >
            <picture>
              <source srcset={`${imageBase(project.image)}.avif`} type="image/avif" />
              <source srcset={`${imageBase(project.image)}.webp`} type="image/webp" />
              <img
                src={`${BASE_URL}${project.image}`}
                alt={`Captura de ${project.title}`}
                width="1600"
                height="900"
                loading="lazy"
                decoding="async"
                class="case-img"
              />
            </picture>

            <span class="shot-veil" aria-hidden="true" />

            {project.status === 'live' && (
              <span class="status-badge">
                <span class="status-dot" aria-hidden="true" />
                {t('projects.live')}
              </span>
            )}

            <span class="shot-cta" aria-hidden="true">
              {t('projects.cta.app')}
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M7 17 17 7M17 7H7M17 7v10" />
              </svg>
            </span>
          </a>

          <div class="container">
            {/* Title sits across the full measure, oversized */}
            <div class="case-head">
              <span class="case-number" aria-hidden="true">{project.number}</span>
              <h3 class="case-title">{project.title}</h3>
              <span class="case-category">{project.category}</span>
            </div>

            {/* Spec table — the thing that makes it read as a case study */}
            <dl class="case-specs">
              {specs.map((spec) => (
                <div class="spec">
                  <dt>{spec.label}</dt>
                  <dd>{spec.value}</dd>
                </div>
              ))}
              <div class="spec spec-stack">
                <dt>{t('projects.spec.stack')}</dt>
                <dd>
                  <ul class="stack-marks">
                    {project.tags.map((tag) => (
                      <li>{tag}</li>
                    ))}
                  </ul>
                </dd>
              </div>
            </dl>

            <div class="case-body">
              <p class="case-lead">{project.longDescription}</p>

              <div class="case-ctas">
                <a
                  href={project.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-primary"
                  aria-label={
                    lang === 'es'
                      ? `Ver ${project.title} en producción (abre en nueva pestaña)`
                      : `View ${project.title} live (opens in new tab)`
                  }
                >
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6" />
                    <polyline points="15 3 21 3 21 9" />
                    <line x1="10" y1="14" x2="21" y2="3" />
                  </svg>
                  {t('projects.cta.app')}
                </a>
                <a
                  href={project.githubUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="btn btn-ghost"
                  aria-label={`Código fuente de ${project.title} en GitHub`}
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z" />
                  </svg>
                  GitHub
                </a>
              </div>
            </div>
          </div>
        </article>
      );
    })
  }

  <div class="container">
    <a
      href={SOCIALS.github}
      target="_blank"
      rel="noopener noreferrer"
      class="more-link"
      data-reveal
    >
      <span>{t('projects.more')}</span>
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <line x1="5" y1="12" x2="19" y2="12" />
        <polyline points="12 5 19 12 12 19" />
      </svg>
    </a>
  </div>
</section>

<script>
  // Pointer-tracked tilt on the full-bleed shot. Rotation goes straight to
  // CSS custom properties so the compositor does the work, no rAF loop.
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const fine = window.matchMedia('(pointer: fine)');

  if (!reduced.matches && fine.matches) {
    const MAX = 3; // degrees — subtle, the shot is large

    document.querySelectorAll<HTMLElement>('.case-shot').forEach((shot) => {
      shot.addEventListener(
        'pointermove',
        (e) => {
          const r = shot.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width - 0.5;
          const py = (e.clientY - r.top) / r.height - 0.5;

          shot.classList.add('is-tilting');
          shot.style.setProperty('--ry', `${px * MAX * 2}deg`);
          shot.style.setProperty('--rx', `${-py * MAX * 2}deg`);
        },
        { passive: true }
      );

      shot.addEventListener('pointerleave', () => {
        shot.classList.remove('is-tilting');
        shot.style.setProperty('--rx', '0deg');
        shot.style.setProperty('--ry', '0deg');
      });
    });
  }
</script>

<style>
  /* ---------------------------------------------------------------
     Case study
     A single project has to carry the whole section, so it gets the
     full viewport width and a spec table rather than sitting in a card.
  --------------------------------------------------------------- */
  .case + .case {
    margin-top: clamp(4rem, 8vw, 7rem);
  }

  /* ---- Full-bleed shot ---- */
  .case-shot {
    position: relative;
    display: block;
    width: 100%;
    margin-bottom: clamp(1.75rem, 4vw, 3rem);
    overflow: hidden;
    border-block: 1px solid var(--color-border);
    background: var(--color-bg-elevated);
    transform: perspective(1600px) rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    will-change: transform;
  }

  .case-shot:not(.is-tilting) {
    transition: transform 600ms var(--ease-out-soft);
  }

  .case-img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    object-position: top center;
    /* RefrigeraSpace has a light UI. Full-bleed and untreated it becomes a
       white slab that blows out the page, so it rests dimmed and only comes
       up to full brightness under the pointer. */
    filter: brightness(0.42) saturate(0.75) contrast(1.05);
    transition:
      scale 700ms var(--ease-out-soft),
      filter 500ms var(--ease-out-soft);
  }

  .case-shot:hover .case-img,
  .case-shot:focus-visible .case-img {
    filter: brightness(0.92) saturate(1) contrast(1);
    scale: 1.015;
  }

  /* Melts the shot into the page instead of sitting it on top */
  .shot-veil {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      linear-gradient(to top, var(--color-bg) 1%, transparent 45%),
      linear-gradient(to bottom, var(--color-bg) 1%, transparent 35%),
      linear-gradient(to right, var(--color-bg) 0%, transparent 22%, transparent 78%, var(--color-bg) 100%);
    transition: opacity var(--transition-slow);
  }

  .case-shot:hover .shot-veil {
    opacity: 0.55;
  }

  .status-badge {
    position: absolute;
    top: clamp(1rem, 3vw, 1.75rem);
    left: clamp(1rem, 5vw, 2rem);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.32rem 0.7rem;
    border-radius: 999px;
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-bg-sunken) 78%, transparent);
    backdrop-filter: blur(6px);
    border: 1px solid var(--color-border-accent);
  }

  .status-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--color-accent);
    box-shadow: 0 0 8px var(--color-accent);
  }

  .shot-cta {
    position: absolute;
    right: clamp(1rem, 5vw, 2rem);
    bottom: clamp(1.5rem, 4vw, 2.5rem);
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.5rem 1rem;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--color-bg);
    background: var(--color-accent);
    opacity: 0;
    translate: 0 0.5rem;
    transition:
      opacity var(--transition-base),
      translate var(--transition-base);
  }

  .case-shot:hover .shot-cta,
  .case-shot:focus-visible .shot-cta {
    opacity: 1;
    translate: 0 0;
  }

  /* ---- Head ---- */
  .case-head {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 0.6rem 1.1rem;
    margin-bottom: 1.5rem;
  }

  .case-number {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--color-accent);
    font-variant-numeric: tabular-nums;
  }

  .case-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5.5vw, 3.6rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .case-category {
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  /* ---- Spec table ---- */
  .case-specs {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1.25rem 2rem;
    padding-block: 1.4rem;
    border-block: 1px solid var(--color-border);
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }

  .spec-stack {
    grid-column: span 2;
  }

  .spec dt {
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin-bottom: 0.45rem;
  }

  .spec dd {
    font-size: 0.9rem;
    color: var(--color-text);
    line-height: 1.5;
  }

  .stack-marks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 0.7rem;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .stack-marks li + li::before {
    content: '/';
    margin-right: 0.7rem;
    color: var(--color-border-strong);
  }

  /* ---- Body ---- */
  .case-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: clamp(1.5rem, 4vw, 3.5rem);
  }

  .case-lead {
    font-size: clamp(0.95rem, 1.5vw, 1.08rem);
    line-height: 1.8;
    color: var(--color-text-muted);
    max-width: 62ch;
  }

  .case-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  /* ---- More on GitHub ---- */
  .more-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    width: 100%;
    font-size: 0.85rem;
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .more-link svg {
    transition: translate var(--transition-fast);
  }

  .more-link:hover {
    color: var(--color-accent);
  }

  .more-link:hover svg {
    translate: 4px 0;
  }

  @media (max-width: 860px) {
    .case-img {
      aspect-ratio: 16 / 10;
    }

    .case-specs {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .spec-stack {
      grid-column: 1 / -1;
    }

    .case-body {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .case-shot {
      transform: none;
    }
  }
</style>
